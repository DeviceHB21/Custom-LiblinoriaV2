--[[
	Crescent UI Library  (recreation)
	Single-file Roblox Lua UI library.

	Usage:
		local Crescent = loadstring(game:HttpGet("<your raw url>"))()
		local Window = Crescent:CreateWindow({ Title = "Crescent", Subtitle = "hack" })
		local Cat    = Window:AddTab("Aim Assistance", "rbxassetid://...")   -- sidebar category
		local Tab    = Cat:AddTab("Aimbot")                                  -- top tab
		local Box    = Tab:AddLeftGroupbox("Aimbot")                         -- or AddRightGroupbox
		Box:AddToggle({ Text = "Selected Toggle", Default = true, Callback = function(v) end })
]]

local Crescent = {}
Crescent.__index = Crescent

--========================= services =========================
local cloneref = cloneref or function(o) return o end
local TweenService   = cloneref(game:GetService("TweenService"))
local UserInputService= cloneref(game:GetService("UserInputService"))
local RunService     = cloneref(game:GetService("RunService"))
local Players        = cloneref(game:GetService("Players"))
local TextService    = cloneref(game:GetService("TextService"))
local LocalPlayer    = Players.LocalPlayer

--========================= theme =========================
local Theme = {
	Window   = Color3.fromRGB(24, 25, 28),
	Sidebar  = Color3.fromRGB(19, 20, 23),
	Content  = Color3.fromRGB(24, 25, 28),
	Group    = Color3.fromRGB(28, 30, 34),
	Control  = Color3.fromRGB(33, 35, 41),
	Stroke   = Color3.fromRGB(42, 44, 51),
	Accent   = Color3.fromRGB(93, 160, 255),
	AccentDim= Color3.fromRGB(58, 108, 214),
	Text     = Color3.fromRGB(235, 237, 244),
	SubText  = Color3.fromRGB(150, 154, 168),
	Muted    = Color3.fromRGB(104, 108, 122),
	Hover    = Color3.fromRGB(38, 40, 47),
}
Crescent.Theme = Theme
Crescent.Flags = {}

local FONT      = Enum.Font.GothamMedium
local FONT_BOLD = Enum.Font.GothamBold

local TW_FAST = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TW_MED  = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TW_SLOW = TweenInfo.new(0.30, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

--========================= helpers =========================
local function new(class, props, children)
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then inst[k] = v end
		end
		if props.Parent then inst.Parent = props.Parent end
	end
	if children then
		for _, c in ipairs(children) do c.Parent = inst end
	end
	return inst
end

local function corner(parent, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
	return new("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function pad(parent, all)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, all), PaddingRight = UDim.new(0, all),
		PaddingTop = UDim.new(0, all), PaddingBottom = UDim.new(0, all),
		Parent = parent,
	})
end

local function tween(inst, info, props)
	local t = TweenService:Create(inst, info, props)
	t:Play()
	return t
end

local function textSize(text, size, font)
	return TextService:GetTextSize(text, size, font or FONT, Vector2.new(9999, 9999))
end

--========================= mount =========================
local function getGui()
	local gui = new("ScreenGui", {
		Name = "CrescentUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Global,
		IgnoreGuiInset = true,
	})
	local ok = pcall(function()
		if gethui then gui.Parent = gethui()
		elseif syn and syn.protect_gui then syn.protect_gui(gui); gui.Parent = cloneref(game:GetService("CoreGui"))
		else gui.Parent = cloneref(game:GetService("CoreGui")) end
	end)
	if not ok or not gui.Parent then
		gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
	return gui
end

local function makeDraggable(handle, target)
	local dragging, startPos, startInput
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startInput = input.Position
			startPos = target.Position
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					conn:Disconnect()
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - startInput
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

--========================= window =========================
function Crescent:CreateWindow(opts)
	opts = opts or {}
	local gui = getGui()

	local window = setmetatable({
		Gui = gui,
		Categories = {},
		CurrentCategory = nil,
		Minimized = false,
	}, { __index = {} })

	local Root = new("Frame", {
		Name = "Window",
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(opts.Width or 600, opts.Height or 380),
		BackgroundColor3 = Theme.Window,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	})
	corner(Root, 10)
	stroke(Root, Theme.Stroke, 1, 0.3)
	window.Root = Root

	-- open animation
	Root.Size = UDim2.fromOffset(0, 0)
	Root.BackgroundTransparency = 1
	tween(Root, TW_SLOW, { Size = UDim2.fromOffset(opts.Width or 600, opts.Height or 380), BackgroundTransparency = 0 })

	------------------------------------------------ title bar
	local TitleBar = new("Frame", {
		Name = "TitleBar", Parent = Root, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 42),
	})
	makeDraggable(TitleBar, Root)

	-- moon badge
	local Badge = new("Frame", {
		Parent = TitleBar, BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
	})
	corner(Badge, 9)
	local MoonCut = new("Frame", {
		Parent = Badge, BackgroundColor3 = Theme.Window, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.72, 0.42),
		Size = UDim2.fromOffset(14, 14),
	})
	corner(MoonCut, 7)

	local TitleA = new("TextLabel", {
		Parent = TitleBar, BackgroundTransparency = 1, Font = FONT_BOLD,
		Text = opts.Title or "Crescent", TextColor3 = Theme.Text, TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 42, 0, 0), Size = UDim2.new(0, 120, 1, 0),
	})
	local aw = textSize(TitleA.Text, 15, FONT_BOLD).X
	TitleA.Size = UDim2.new(0, aw + 2, 1, 0)
	new("TextLabel", {
		Parent = TitleBar, BackgroundTransparency = 1, Font = FONT_BOLD,
		Text = opts.Subtitle or "hack", TextColor3 = Theme.Muted, TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 42 + aw + 2, 0, 0), Size = UDim2.new(0, 80, 1, 0),
	})

	-- min / close
	local CloseBtn = new("TextButton", {
		Parent = TitleBar, BackgroundTransparency = 1, Font = FONT_BOLD, Text = "✕",
		TextColor3 = Theme.Muted, TextSize = 15, AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(20, 20),
	})
	local MinBtn = new("TextButton", {
		Parent = TitleBar, BackgroundTransparency = 1, Font = FONT_BOLD, Text = "—",
		TextColor3 = Theme.Muted, TextSize = 15, AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -40, 0.5, 0), Size = UDim2.fromOffset(20, 20),
	})
	for _, b in ipairs({ CloseBtn, MinBtn }) do
		b.MouseEnter:Connect(function() tween(b, TW_FAST, { TextColor3 = Theme.Text }) end)
		b.MouseLeave:Connect(function() tween(b, TW_FAST, { TextColor3 = Theme.Muted }) end)
	end
	CloseBtn.MouseButton1Click:Connect(function()
		tween(Root, TW_MED, { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }).Completed:Wait()
		gui:Destroy()
	end)

	local fullSize = UDim2.fromOffset(opts.Width or 600, opts.Height or 380)
	MinBtn.MouseButton1Click:Connect(function()
		window.Minimized = not window.Minimized
		if window.Minimized then
			tween(Root, TW_SLOW, { Size = UDim2.fromOffset((opts.Width or 600), 42) })
		else
			tween(Root, TW_SLOW, { Size = fullSize })
		end
	end)

	new("Frame", { -- title divider
		Parent = Root, BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.35,
		BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 42), Size = UDim2.new(1, 0, 0, 1),
	})

	------------------------------------------------ sidebar
	local Sidebar = new("Frame", {
		Name = "Sidebar", Parent = Root, BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 43), Size = UDim2.new(0, 168, 1, -43),
	})
	new("Frame", {
		Parent = Sidebar, BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.35,
		BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 1, 1, 0),
	})

	local NavList = new("ScrollingFrame", {
		Name = "Nav", Parent = Sidebar, BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = UDim2.new(0, 10, 0, 10), Size = UDim2.new(1, -20, 1, -54),
		ScrollBarThickness = 0, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	})
	new("UIListLayout", { Parent = NavList, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })

	-- search box
	local SearchHolder = new("Frame", {
		Parent = Sidebar, BackgroundColor3 = Theme.Control, BackgroundTransparency = 0.3, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -20, 0, 28),
	})
	corner(SearchHolder, 6)
	stroke(SearchHolder, Theme.Stroke, 1, 0.4)
	new("TextLabel", {
		Parent = SearchHolder, BackgroundTransparency = 1, Font = FONT, Text = "⌕",
		TextColor3 = Theme.Muted, TextSize = 16, Position = UDim2.new(0, 8, 0, 0), Size = UDim2.fromOffset(16, 28),
	})
	local SearchBox = new("TextBox", {
		Parent = SearchHolder, BackgroundTransparency = 1, Font = FONT, Text = "",
		PlaceholderText = "Search for element...", PlaceholderColor3 = Theme.Muted,
		TextColor3 = Theme.Text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
		Position = UDim2.new(0, 28, 0, 0), Size = UDim2.new(1, -34, 1, 0),
	})
	window.SearchBox = SearchBox

	------------------------------------------------ top tab bar + content host (per category)
	local TopBar = new("Frame", {
		Name = "TopBar", Parent = Root, BackgroundTransparency = 1,
		Position = UDim2.new(0, 168, 0, 43), Size = UDim2.new(1, -168, 0, 40),
	})
	new("UIListLayout", {
		Parent = TopBar, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
	})
	new("UIPadding", { Parent = TopBar, PaddingLeft = UDim.new(0, 18) })

	local ContentHost = new("Frame", {
		Name = "ContentHost", Parent = Root, BackgroundTransparency = 1,
		Position = UDim2.new(0, 168, 0, 83), Size = UDim2.new(1, -168, 1, -83),
	})

	window._TopBar = TopBar
	window._ContentHost = ContentHost
	window._NavList = NavList

	--============== category (sidebar item) ==============
	function window:AddTab(name, icon)
		local cat = { Name = name, Tabs = {}, CurrentTab = nil }

		-- nav button
		local Btn = new("TextButton", {
			Name = name, Parent = NavList, BackgroundColor3 = Theme.Hover, BackgroundTransparency = 1,
			BorderSizePixel = 0, AutoButtonColor = false, Text = "", Size = UDim2.new(1, 0, 0, 34),
		})
		corner(Btn, 7)
		local IconLbl
		if icon then
			IconLbl = new("ImageLabel", {
				Parent = Btn, BackgroundTransparency = 1, Image = icon, ImageColor3 = Theme.Muted,
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(16, 16),
			})
		end
		local Lbl = new("TextLabel", {
			Parent = Btn, BackgroundTransparency = 1, Font = FONT, Text = name, TextColor3 = Theme.Muted,
			TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0, icon and 34 or 12, 0, 0), Size = UDim2.new(1, -40, 1, 0),
		})

		-- page (top tabs live in TopBar; columns live here)
		local Page = new("Frame", {
			Name = name .. "_Page", Parent = ContentHost, BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1), Visible = false,
		})
		cat.Page = Page
		cat.NavButton = Btn
		cat.Icon = IconLbl
		cat.Label = Lbl

		local function setActive(active)
			if active then
				tween(Btn, TW_FAST, { BackgroundTransparency = 0.82 })
				tween(Lbl, TW_FAST, { TextColor3 = Theme.Text })
				if IconLbl then tween(IconLbl, TW_FAST, { ImageColor3 = Theme.Text }) end
			else
				tween(Btn, TW_FAST, { BackgroundTransparency = 1 })
				tween(Lbl, TW_FAST, { TextColor3 = Theme.Muted })
				if IconLbl then tween(IconLbl, TW_FAST, { ImageColor3 = Theme.Muted }) end
			end
		end
		cat._setActive = setActive

		Btn.MouseEnter:Connect(function() if window.CurrentCategory ~= cat then tween(Btn, TW_FAST, { BackgroundTransparency = 0.9 }) end end)
		Btn.MouseLeave:Connect(function() if window.CurrentCategory ~= cat then tween(Btn, TW_FAST, { BackgroundTransparency = 1 }) end end)

		function cat:_show()
			for _, c in ipairs(window.Categories) do
				c.Page.Visible = false
				c._setActive(false)
				if c._TabBar then c._TabBar.Visible = false end
			end
			Page.Visible = true
			setActive(true)
			if cat._TabBar then cat._TabBar.Visible = true end
			window.CurrentCategory = cat
		end

		Btn.MouseButton1Click:Connect(function() cat:_show() end)

		-- this category's own top-tab bar (clone of TopBar contents)
		local TabBar = new("Frame", {
			Name = name .. "_TabBar", Parent = TopBar, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0), Visible = false,
		})
		new("UIListLayout", {
			Parent = TabBar, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 14),
			VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
		})
		cat._TabBar = TabBar

		--============== top tab ==============
		function cat:AddTab(tabName)
			local tab = { Name = tabName }

			local TBtn = new("TextButton", {
				Name = tabName, Parent = TabBar, BackgroundTransparency = 1, AutoButtonColor = false,
				Font = FONT_BOLD, Text = tabName, TextColor3 = Theme.Muted, TextSize = 13,
				Size = UDim2.fromOffset(textSize(tabName, 13, FONT_BOLD).X, 40),
			})

			local TPage = new("Frame", {
				Name = tabName .. "_TPage", Parent = Page, BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1), Visible = false,
			})
			-- two columns
			local function column(xScale, xOff, wOff)
				local col = new("ScrollingFrame", {
					Parent = TPage, BackgroundTransparency = 1, BorderSizePixel = 0,
					Position = UDim2.new(xScale, xOff, 0, 0), Size = UDim2.new(0.5, wOff, 1, -8),
					ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
				})
				new("UIListLayout", { Parent = col, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
				new("UIPadding", { Parent = col, PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 9), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 12) })
				return col
			end
			tab.Left  = column(0, 0, -9)
			tab.Right = column(0.5, 9, -27)

			local function setTab(active)
				tween(TBtn, TW_FAST, { TextColor3 = active and Theme.Text or Theme.Muted })
				TPage.Visible = active
			end
			tab._setTab = setTab

			TBtn.MouseEnter:Connect(function() if cat.CurrentTab ~= tab then tween(TBtn, TW_FAST, { TextColor3 = Theme.SubText }) end end)
			TBtn.MouseLeave:Connect(function() if cat.CurrentTab ~= tab then tween(TBtn, TW_FAST, { TextColor3 = Theme.Muted }) end end)
			TBtn.MouseButton1Click:Connect(function()
				for _, t in ipairs(cat.Tabs) do t._setTab(false) end
				setTab(true)
				cat.CurrentTab = tab
			end)

			table.insert(cat.Tabs, tab)
			if #cat.Tabs == 1 then setTab(true); cat.CurrentTab = tab end

			--============== groupbox ==============
			local function groupbox(parent, title, icon)
				local box = {}
				local Frame = new("Frame", {
					Parent = parent, BackgroundColor3 = Theme.Group, BackgroundTransparency = 0.25,
					BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 60), AutomaticSize = Enum.AutomaticSize.Y,
				})
				corner(Frame, 8)
				stroke(Frame, Theme.Stroke, 1, 0.3)
				new("UIListLayout", { Parent = Frame, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
				new("UIPadding", { Parent = Frame, PaddingLeft = UDim.new(0,12), PaddingRight = UDim.new(0,12), PaddingTop = UDim.new(0,10), PaddingBottom = UDim.new(0,12) })

				-- header
				local Header = new("Frame", { Parent = Frame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = -999 })
				new("TextLabel", {
					Parent = Header, BackgroundTransparency = 1, Font = FONT_BOLD, Text = title or "Group",
					TextColor3 = Theme.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(0, icon and 22 or 0, 0, 0), Size = UDim2.new(1, -22, 1, 0),
				})
				if icon then
					new("ImageLabel", { Parent = Header, BackgroundTransparency = 1, Image = icon, ImageColor3 = Theme.SubText,
						AnchorPoint = Vector2.new(0,0.5), Position = UDim2.new(0,0,0.5,0), Size = UDim2.fromOffset(16,16) })
				end
				box.Frame = Frame
				box.Window = window
				box.Tab = tab
				return box
			end

			function tab:AddLeftGroupbox(title, icon)  return Crescent._makeGroupbox(groupbox(tab.Left,  title, icon)) end
			function tab:AddRightGroupbox(title, icon) return Crescent._makeGroupbox(groupbox(tab.Right, title, icon)) end

			return tab
		end

		table.insert(window.Categories, cat)
		if #window.Categories == 1 then cat:_show() end
		return cat
	end

	return window
end

--========================= elements =========================
-- attaches element constructors onto a groupbox table
function Crescent._makeGroupbox(box)
	local Frame = box.Frame

	local function row(height)
		return new("Frame", { Parent = Frame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height or 22) })
	end

	-- label on the left of a row
	local function caption(parent, text, widthOff)
		return new("TextLabel", {
			Parent = parent, BackgroundTransparency = 1, Font = FONT, Text = text, TextColor3 = Theme.Text,
			TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, widthOff or -40, 1, 0),
		})
	end

	----------------------------------- Toggle
	function box:AddToggle(o)
		o = o or {}
		local state = o.Default == true
		local R = row(22)
		caption(R, o.Text or "Toggle", -30)
		local Sw = new("Frame", {
			Parent = R, BackgroundColor3 = state and Theme.Accent or Theme.Control, BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(18, 18),
		})
		corner(Sw, 5)
		local sk = stroke(Sw, Theme.Stroke, 1, state and 1 or 0.3)
		local Check = new("ImageLabel", {
			Parent = Sw, BackgroundTransparency = 1, Image = "rbxassetid://6031094667", -- check icon
			ImageColor3 = Color3.fromRGB(255,255,255), ImageTransparency = state and 0 or 1,
			AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.fromScale(0.5,0.5), Size = UDim2.fromOffset(16,16),
		})
		local Hit = new("TextButton", { Parent = R, BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1,1) })

		local api = {}
		local function render()
			tween(Sw, TW_FAST, { BackgroundColor3 = state and Theme.Accent or Theme.Control })
			tween(sk, TW_FAST, { Transparency = state and 1 or 0.3 })
			tween(Check, TW_FAST, { ImageTransparency = state and 0 or 1 })
		end
		function api:Set(v) state = v and true or false; render(); if o.Callback then o.Callback(state) end end
		function api:Get() return state end
		Hit.MouseButton1Click:Connect(function() api:Set(not state) end)
		if o.Flag then Crescent.Flags[o.Flag] = api end
		if o.Callback then o.Callback(state) end
		return api
	end

	----------------------------------- Button
	function box:AddButton(o)
		o = o or {}
		local R = row(26)
		local Btn = new("TextButton", {
			Parent = R, BackgroundColor3 = Theme.Control, BackgroundTransparency = 0.15, BorderSizePixel = 0,
			AutoButtonColor = false, Font = FONT_BOLD, Text = o.Text or "Button", TextColor3 = Theme.Text, TextSize = 12,
			Size = UDim2.fromScale(1, 1),
		})
		corner(Btn, 6)
		local bs = stroke(Btn, Theme.Stroke, 1, 0.4)
		Btn.MouseEnter:Connect(function() tween(Btn, TW_FAST, { BackgroundTransparency = 0 }); tween(bs, TW_FAST, { Color = Theme.Accent, Transparency = 0.2 }) end)
		Btn.MouseLeave:Connect(function() tween(Btn, TW_FAST, { BackgroundTransparency = 0.15 }); tween(bs, TW_FAST, { Color = Theme.Stroke, Transparency = 0.4 }) end)
		Btn.MouseButton1Click:Connect(function()
			tween(Btn, TW_FAST, { BackgroundColor3 = Theme.Accent }).Completed:Connect(function()
				tween(Btn, TW_FAST, { BackgroundColor3 = Theme.Control })
			end)
			if o.Callback then o.Callback() end
		end)
		return { Instance = Btn }
	end

	----------------------------------- Label
	function box:AddLabel(o)
		o = o or {}
		local R = row(18)
		R.AutomaticSize = Enum.AutomaticSize.Y
		local L = new("TextLabel", {
			Parent = R, BackgroundTransparency = 1, Font = FONT, Text = o.Text or "Label", TextColor3 = Theme.Text,
			TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.Y,
		})
		local D
		if o.Description then
			D = new("TextLabel", {
				Parent = R, BackgroundTransparency = 1, Font = FONT, Text = o.Description, TextColor3 = Theme.Muted,
				TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
				Position = UDim2.new(0, 0, 0, 17), Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.Y,
			})
		end
		return {
			SetText = function(_, t) L.Text = t end,
			SetDescription = function(_, t) if D then D.Text = t end end,
		}
	end

	----------------------------------- Slider
	function box:AddSlider(o)
		o = o or {}
		local min, max = o.Min or 0, o.Max or 100
		local value = math.clamp(o.Default or min, min, max)
		local decimals = o.Decimals or 0
		local function roundv(v) local m = 10 ^ decimals; return math.floor(v * m + 0.5) / m end

		local Head = row(16)
		caption(Head, o.Text or "Slider", -46)
		local Val = new("TextLabel", {
			Parent = Head, BackgroundTransparency = 1, Font = FONT, Text = tostring(value) .. (o.Suffix or "%"),
			TextColor3 = Theme.Muted, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,0,0,0), Size = UDim2.new(0, 46, 1, 0),
		})
		local Bar = new("Frame", {
			Parent = Frame, BackgroundColor3 = Theme.Control, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 8),
		})
		corner(Bar, 4)
		local Fill = new("Frame", { Parent = Bar, BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.new((value-min)/(max-min), 0, 1, 0) })
		corner(Fill, 4)
		new("UIGradient", { Parent = Fill, Color = ColorSequence.new(Theme.AccentDim, Theme.Accent) })

		local dragging = false
		local function setFromX(px)
			local a = Bar.AbsolutePosition.X
			local b = a + Bar.AbsoluteSize.X
			local alpha = math.clamp((px - a) / math.max(1, (b - a)), 0, 1)
			value = roundv(min + (max - min) * alpha)
			Val.Text = tostring(value) .. (o.Suffix or "%")
			tween(Fill, TW_FAST, { Size = UDim2.new((value-min)/(max-min), 0, 1, 0) })
			if o.Callback then o.Callback(value) end
		end
		Bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; setFromX(i.Position.X) end end)
		Bar.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
		UserInputService.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setFromX(i.Position.X) end end)

		local api = {}
		function api:Set(v) value = math.clamp(roundv(v), min, max); Val.Text = tostring(value)..(o.Suffix or "%"); tween(Fill, TW_FAST, { Size = UDim2.new((value-min)/(max-min),0,1,0) }); if o.Callback then o.Callback(value) end end
		function api:Get() return value end
		if o.Flag then Crescent.Flags[o.Flag] = api end
		return api
	end

	----------------------------------- Input
	function box:AddInput(o)
		o = o or {}
		if o.Text then
			local H = row(16); caption(H, o.Text, 0)
		end
		local R = row(26)
		local Holder = new("Frame", { Parent = R, BackgroundColor3 = Theme.Control, BackgroundTransparency = 0.2, BorderSizePixel = 0, Size = UDim2.fromScale(1,1) })
		corner(Holder, 6); stroke(Holder, Theme.Stroke, 1, 0.4)
		local Box = new("TextBox", {
			Parent = Holder, BackgroundTransparency = 1, Font = FONT, Text = o.Default or "",
			PlaceholderText = o.Placeholder or "Input...", PlaceholderColor3 = Theme.Muted,
			TextColor3 = Theme.Text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
			Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -16, 1, 0),
		})
		Box.FocusLost:Connect(function() if o.Callback then o.Callback(Box.Text) end end)
		return { Get = function() return Box.Text end, Set = function(_, t) Box.Text = t end }
	end

	----------------------------------- Keybind
	function box:AddKeybind(o)
		o = o or {}
		local R = row(22)
		caption(R, o.Text or "Keybind", -40)
		local key = o.Default
		local Badge = new("TextButton", {
			Parent = R, BackgroundColor3 = Theme.Control, BackgroundTransparency = 0.2, BorderSizePixel = 0,
			AutoButtonColor = false, Font = FONT_BOLD, Text = key and (tostring(key):gsub("Enum.KeyCode.", "")) or "None",
			TextColor3 = Theme.Text, TextSize = 11, AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,0,0.5,0),
			Size = UDim2.fromOffset(40, 18),
		})
		corner(Badge, 4); stroke(Badge, Theme.Stroke, 1, 0.4)
		local function fit() Badge.Size = UDim2.fromOffset(math.max(28, textSize(Badge.Text, 11, FONT_BOLD).X + 14), 18) end
		fit()
		local binding = false
		Badge.MouseButton1Click:Connect(function()
			binding = true; Badge.Text = "..."; fit()
			local conn
			conn = UserInputService.InputBegan:Connect(function(input, gp)
				if input.UserInputType == Enum.UserInputType.Keyboard then
					key = input.KeyCode
					Badge.Text = tostring(key.Name)
					binding = false; fit(); conn:Disconnect()
					if o.Callback then o.Callback(key) end
				end
			end)
		end)
		UserInputService.InputBegan:Connect(function(input, gp)
			if not binding and key and input.KeyCode == key and not gp then
				if o.Callback then o.Callback(key, true) end
			end
		end)
		return { Get = function() return key end }
	end

	----------------------------------- Dropdown (single / multi)
	function box:AddDropdown(o)
		o = o or {}
		local values = o.Values or {}
		local multi = o.Multi == true
		local selected = multi and {} or (o.Default or (values[1]))
		if multi and type(o.Default) == "table" then for _, v in ipairs(o.Default) do selected[v] = true end end

		if o.Text then local H = row(16); caption(H, o.Text, 0) end
		local R = row(26)
		local Holder = new("TextButton", {
			Parent = R, BackgroundColor3 = Theme.Control, BackgroundTransparency = 0.2, BorderSizePixel = 0,
			AutoButtonColor = false, Text = "", Size = UDim2.fromScale(1, 1),
		})
		corner(Holder, 6); stroke(Holder, Theme.Stroke, 1, 0.4)
		local Disp = new("TextLabel", {
			Parent = Holder, BackgroundTransparency = 1, Font = FONT, TextColor3 = Theme.SubText, TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -30, 1, 0),
		})
		new("TextLabel", { Parent = Holder, BackgroundTransparency = 1, Font = FONT_BOLD, Text = "+", TextColor3 = Theme.Muted,
			TextSize = 16, AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-10,0.5,0), Size = UDim2.fromOffset(14,14) })

		local function display()
			if multi then
				local t = {}
				for _, v in ipairs(values) do if selected[v] then table.insert(t, v) end end
				Disp.Text = #t > 0 and table.concat(t, ", ") or "..."
			else
				Disp.Text = selected ~= nil and tostring(selected) or "..."
			end
		end
		display()

		-- popup
		local Pop = new("Frame", {
			Parent = window.Gui, BackgroundColor3 = Theme.Group, BorderSizePixel = 0, Visible = false,
			Size = UDim2.fromOffset(10, 10), ClipsDescendants = true, ZIndex = 50,
		})
		corner(Pop, 6); stroke(Pop, Theme.Stroke, 1, 0.25)
		local Scroll = new("ScrollingFrame", { Parent = Pop, BackgroundTransparency = 1, BorderSizePixel = 0,
			Position = UDim2.fromOffset(4,4), Size = UDim2.new(1,-8,1,-8), ScrollBarThickness = 2, ZIndex = 51,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y })
		new("UIListLayout", { Parent = Scroll, Padding = UDim.new(0,2), SortOrder = Enum.SortOrder.LayoutOrder })

		local open = false
		local function rebuild()
			for _, c in ipairs(Scroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
			for _, v in ipairs(values) do
				local on = multi and selected[v] or (selected == v)
				local Item = new("TextButton", {
					Parent = Scroll, BackgroundColor3 = Theme.Hover, BackgroundTransparency = on and 0.6 or 1, BorderSizePixel = 0,
					AutoButtonColor = false, Font = FONT, Text = "  " .. tostring(v), TextColor3 = on and Theme.Text or Theme.SubText,
					TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 24), ZIndex = 52,
				})
				corner(Item, 4)
				Item.MouseButton1Click:Connect(function()
					if multi then selected[v] = not selected[v] else selected = v end
					display(); rebuild()
					if o.Callback then o.Callback(selected) end
					if not multi then open = false; Pop.Visible = false end
				end)
			end
		end

		local function place()
			local ap, az = Holder.AbsolutePosition, Holder.AbsoluteSize
			local h = math.min(#values * 26 + 8, 160)
			Pop.Position = UDim2.fromOffset(ap.X, ap.Y + az.Y + 4)
			Pop.Size = UDim2.fromOffset(az.X, h)
		end

		Holder.MouseButton1Click:Connect(function()
			open = not open
			if open then place(); rebuild(); Pop.Visible = true else Pop.Visible = false end
		end)
		UserInputService.InputBegan:Connect(function(input)
			if open and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				local m = UserInputService:GetMouseLocation()
				local p, s = Pop.AbsolutePosition, Pop.AbsoluteSize
				local hp, hs = Holder.AbsolutePosition, Holder.AbsoluteSize
				local inPop = m.X >= p.X and m.X <= p.X+s.X and m.Y >= p.Y and m.Y <= p.Y+s.Y
				local inHolder = m.X >= hp.X and m.X <= hp.X+hs.X and m.Y >= hp.Y and m.Y <= hp.Y+hs.Y
				if not inPop and not inHolder then open = false; Pop.Visible = false end
			end
		end)

		local api = {}
		function api:Get() return selected end
		function api:Set(v) selected = v; display() end
		function api:SetValues(t) values = t; display() end
		if o.Flag then Crescent.Flags[o.Flag] = api end
		return api
	end

	return box
end

return Crescent
